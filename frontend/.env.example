# ==============================================================================
# Regent Frontend Environment Configuration
# ==============================================================================
# The frontend defaults to Demo / Simulation mode with zero configuration.
# Set the variables below to enable Live Base Sepolia execution, Smart Account
# delegation, on-chain mandate registration, and Neon database persistence.

# AI Agent Service URL (defaults to http://localhost:4801)
AGENT_URL=http://localhost:4801

# RegentMandate deployed contract address on Base Sepolia
# Unset = demo mode (on-chain calls skipped, simulated authorization)
NEXT_PUBLIC_MANDATE_CONTRACT=0x...

# Authorized agent signer address for executing mandates
NEXT_PUBLIC_AGENT_ADDRESS=0x...

# Target chain ID (84532 for Base Sepolia)
NEXT_PUBLIC_CHAIN_ID=84532

# ERC-4337 Bundler RPC endpoint (optional; when unset, smart account deploys via EOA)
NEXT_PUBLIC_BUNDLER_URL=

# Neon serverless PostgreSQL connection string for persisting mandates
# Unset = falls back to local storage
DATABASE_URL=postgresql://user:password@ep-example.pooler.neon.tech/regent?sslmode=require
